<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/controls_layout"
    android:layout_width="fill_parent"
    android:layout_height="fill_parent"
    android:layout_gravity="center"
    android:layout_marginBottom="20dp"
    android:focusable="true"
    android:focusableInTouchMode="true"
    android:gravity="center"
    android:orientation="horizontal"
    android:padding="5dp"
    tools:showIn="@layout/limbo_main">

    <LinearLayout
        android:id="@+id/controlm"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:layout_weight="1"
        android:focusable="true"
        android:focusableInTouchMode="true"
        android:gravity="center"
        android:orientation="horizontal">

        <ImageButton
            android:id="@+id/startvm"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentBottom="true"
            android:layout_centerHorizontal="true"
            android:layout_weight="1"
            android:focusable="true"
            android:src="@drawable/play" />

        <ImageButton
            android:id="@+id/pausevm"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentBottom="true"
            android:layout_centerHorizontal="true"
            android:layout_weight="1"
            android:focusable="true"
            android:src="@drawable/pause" />

        <ImageButton
            android:id="@+id/stopvm"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:focusable="true"
            android:src="@drawable/stop" />

        <ImageButton
            android:id="@+id/restartvm"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_weight="1"

            android:focusable="true"
            android:src="@drawable/reset" />
    </LinearLayout>

    <!-- Small runtime controls; keep Limbo's existing VM transport buttons unchanged. -->
    <LinearLayout
        android:id="@+id/runtime_controls"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@id/controlm"
        android:layout_centerHorizontal="true"
        android:layout_marginTop="4dp"
        android:gravity="center"
        android:orientation="horizontal">

        <ImageButton
            android:id="@+id/firmwarevm"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_margin="2dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Firmware: SeaBIOS or UEFI"
            android:padding="7dp"
            android:src="@drawable/sysfile" />

        <ImageButton
            android:id="@+id/graphicsvm"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_margin="2dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Guest graphics backend"
            android:padding="7dp"
            android:src="@drawable/screen" />

        <ImageButton
            android:id="@+id/hostcpuvm"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_margin="2dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Host CPU affinity"
            android:padding="7dp"
            android:src="@drawable/cpu" />

        <ImageButton
            android:id="@+id/memoryvm"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_margin="2dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Optimize guest RAM"
            android:padding="7dp"
            android:src="@drawable/advanced" />
    </LinearLayout>
</RelativeLayout>